<Window x:Class="SmartFinance.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartFinance"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="1200"
                           MinHeight="200" MinWidth="1200">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель ввода -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" VerticalAlignment="Center">
            <TextBlock Text="Date:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <DatePicker SelectedDate="{Binding Date}" Width="130"/>

            <TextBlock Text="Amount:" VerticalAlignment="Center" Margin="12,0,6,0"/>
            <TextBox Text="{Binding AmountText}" Width="110"/>

            <TextBlock Text="Category:" VerticalAlignment="Center" Margin="12,0,6,0"/>
            <TextBox Text="{Binding Category}" Width="140"/>

            <TextBlock Text="Note:" VerticalAlignment="Center" Margin="12,0,6,0"/>
            <TextBox Text="{Binding Note}" Width="220"/>

            <TextBlock Text="Type:" VerticalAlignment="Center" Margin="12,0,6,0"/>
            <ComboBox Width="100"
                      ItemsSource="{Binding Types}"
                      SelectedItem="{Binding SelectedType}"/>
            
            <Button Content="Add"
                    Command="{Binding AddCommand}"
                    Width="80"
                    Margin="12,0,0,0"/>
            
            <Button x:Name="DeleteButton"
                    Content="Delete"
                    Command="{Binding DeleteSelectedCommand}"
                    Width="80"
                    Margin="8,0,0,0"/>
        </StackPanel>

        <!-- Таблица -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedTransaction}"
                  LostKeyboardFocus="TransactionsGrid_LostKeyboardFocus"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=d}" Width="120"/>
                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="90"/>
                <DataGridTextColumn Header="Amount" Binding="{Binding Amount}" Width="100"/>
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="140"/>
                <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
